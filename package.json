{
  "name": "cacheline",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript caching toolkit: GetOrSet, TTL jitter, soft TTL / early refresh, singleflight, and an optional Redis store.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "ioredis": "^5.11.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
